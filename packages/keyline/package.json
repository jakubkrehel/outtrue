{
  "name": "@jakubkrehel/keyline",
  "version": "0.1.0",
  "description": "Oxlint rules that keep code on the design system: tokens, props, imports and composition.",
  "keywords": [
    "agents",
    "ai",
    "design-system",
    "lint",
    "oxlint",
    "oxlint-plugin",
    "tailwind"
  ],
  "homepage": "https://github.com/jakubkrehel/keyline#readme",
  "bugs": "https://github.com/jakubkrehel/keyline/issues",
  "license": "MIT",
  "author": "Jakub Krehel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakubkrehel/keyline.git",
    "directory": "packages/keyline"
  },
  "bin": {
    "keyline-baseline": "baseline.mjs"
  },
  "files": [
    "dist",
    "configs",
    "baseline.mjs",
    "OPTIONS.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.mts",
      "default": "./dist/plugin.mjs"
    },
    "./configs/*.json": "./configs/*.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxlint": "1.92.0",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "peerDependencies": {
    "oxlint": ">=1.92.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
