{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["**/dist/**", "**/CHANGELOG.md"],
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "import",
    "node",
    "oxc",
    "vitest",
  ],
  "env": {
    "builtin": true,
    "node": true,
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
  },
}
